    "npm:pi-context-view@0.6.0",
    "npm:@ahm3tj4f/pi-undo@0.4.0",
    "npm:@rahularya01/pi-cursor@1.4.36",
    "../../ghq/github.com/sorafujitani/pi-extension",
    "git:github.com/sorafujitani/pi-codex-cloud@da4211765a4ca9cf68a4d2f53aeb5f61870c54f4",
    "git:github.com/DietrichGebert/ponytail",
    "git:github.com/earendil-works/pi-review",
