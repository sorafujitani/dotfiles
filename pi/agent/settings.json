      "maxRetryDelayMs": 60000
    }
  },
  "npmCommand": [
    "mise",
    "exec",
    "node@26.4.0",
    "--",
    "npm"
  ],
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "xai/grok-4.6",
