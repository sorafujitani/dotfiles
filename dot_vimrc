" Portable Vim configuration: copy this file to ~/.vimrc (Vim 8+).
set nocompatible
let mapleader = ' '
filetype plugin indent on
syntax enable

set encoding=utf-8
set fileencoding=utf-8
set noswapfile hidden autoread
set synmaxcol=300 updatetime=250
set helplang=ja
set number relativenumber nowrap showmatch
set shiftwidth=2 tabstop=2 expandtab autoindent smartindent
set hlsearch incsearch matchtime=1
set timeoutlen=300
set wildmenu
set wildmode=longest:full,full
set laststatus=2
set background=dark
if exists('+mouse')
  set mouse=a
endif
if exists('+signcolumn')
  set signcolumn=yes
endif
if exists('+termguicolors') && ($COLORTERM ==# 'truecolor' || $COLORTERM ==# '24bit')
  set termguicolors
endif
" Match the local Neovim palette in lua/ui/highlights.lua without plugins.
" GUI/truecolor uses the same RGB values; cterm uses nearby 256-color values.
